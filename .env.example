# ---- OpenAI (required) ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=your-chat-model            # e.g. the model you were given
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                            # must match the embedding model's output size

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                             # set when using Qdrant Cloud / secured Qdrant
QDRANT_COLLECTION=agent_memories

# ---- HTTP API ----
# APP_API_KEY=change-me                       # if set, clients must send header X-API-Key

# ---- Tuning (defaults are sensible) ----
# RECALL_TOP_K=5
# RECALL_MIN_SCORE=0.30
# DUPLICATE_THRESHOLD=0.95
# CONSOLIDATION_THRESHOLD=0.88
# PURGE_AFTER_DAYS=30
# LOG_LEVEL=INFO
# LOG_JSON=false
